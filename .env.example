# Frontend
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_API_URL="/api"

# Backend
API_PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lavajato"
DATABASE_SSL="false"
SKIP_STARTUP_SCHEMA="false"
AUTH_SESSION_DAYS=7
SESSION_COOKIE_NAME="lavajato_session"
SESSION_COOKIE_SAME_SITE="Lax"
SESSION_COOKIE_SECURE="auto"
TRUST_PROXY_HOPS=1
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=6
ADMIN_INITIAL_PASSWORD="Troque-esta-senha-em-producao!"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://127.0.0.1"
ALLOWED_REMOTE_IMAGE_HOSTS="teslaeventos.com.br,images.unsplash.com,i.pravatar.cc"

# Password reset email via AWS SES. The sender must be verified in SES.
PUBLIC_APP_URL="https://3-145-153-19.sslip.io/"
AWS_SES_REGION="us-east-2"
PASSWORD_RESET_FROM_EMAIL=""
PASSWORD_RESET_FROM_NAME="Lava Jato Norte Tech"
PASSWORD_RESET_REPLY_TO=""
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS=4
