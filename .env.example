# =============================================================
# Frontend (baked into build via Vite)
# =============================================================

# Supabase Edge Function URL — used in production build.
# In dev, vite.config.ts proxies /api -> Supabase automatically.
VITE_API_URL=https://vqutbhklwnvvpmvletqb.supabase.co/functions/v1/api

# Gemini API key (optional – used for AI assistant features)
VITE_GEMINI_API_KEY=

# =============================================================
# Supabase Edge Function secrets
# Set these in the Supabase Dashboard → Project → Edge Functions → Secrets
# or via: supabase secrets set KEY=value --project-ref vqutbhklwnvvpmvletqb
# =============================================================

# Automatically injected by Supabase runtime — no need to set manually:
# SUPABASE_URL=https://vqutbhklwnvvpmvletqb.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Session duration for custom auth tokens (days)
AUTH_SESSION_DAYS=7

# Storage bucket name for inspection photos
UPLOAD_BUCKET=uploads

# =============================================================
# GitHub Actions secrets required for CI/CD
# =============================================================
# CLOUDFLARE_API_TOKEN      — Cloudflare API token with Pages deploy permission
# CLOUDFLARE_ACCOUNT_ID     — Your Cloudflare account ID
# SUPABASE_ACCESS_TOKEN     — Supabase personal access token (supabase.com/dashboard/account/tokens)
# SUPABASE_ANON_KEY         — Project anon/public key (used for health check)
# VITE_GEMINI_API_KEY       — Gemini API key (same as above, injected at build time)
