{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "api": "node server/index.mjs",
    "build": "node scripts/run-vite-build.mjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:client-registration": "node scripts/test-client-registration.mjs",
    "test:access-rules": "node scripts/test-access-rules.mjs",
    "test:dashboard": "node scripts/test-dashboard-metrics.mjs",
    "test:bootstrap-refresh": "node scripts/test-bootstrap-refresh.mjs",
    "test:single-app-logo": "node scripts/test-single-app-logo.mjs",
    "test:password-reset": "node scripts/test-password-reset.mjs",
    "test:taruma-rules": "node scripts/test-taruma-scheduling-rules.mjs",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "docs:update": "node scripts/update-persistence-docs.mjs",
    "docs:check": "node scripts/check-persistence-docs.mjs",
    "handoff:update": "node scripts/update-handoff.mjs",
    "handoff:check": "node scripts/check-handoff.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1021.0",
    "@aws-sdk/client-sesv2": "^3.1054.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp": "^8.4.1"
    }
  }
}
